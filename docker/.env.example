# Copy this file to docker/.env before running Docker Compose.
# Use long, unique values and never commit docker/.env.

WGD_IMAGE=ghcr.io/hosseinpv1379/wgdashboard:latest
WG_NODE_IMAGE=ghcr.io/hosseinpv1379/wg-node:latest
VCS_URL=https://github.com/hosseinpv1379/WGDashboard
WGD_ADMIN_USERNAME=admin
WGD_ADMIN_PASSWORD=replace-with-a-strong-admin-password
WGD_LANGUAGE=en-US

DATABASE_TYPE=postgresql
POSTGRES_USER=wgdashboard
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Stable volume names. If this server already has WGDashboard installed, use
# `docker inspect wgdashboard --format '{{range .Mounts}}{{println .Name .Destination}}{{end}}'`
# and replace these values with the old names before the first upgrade start.
AMNEZIA_CONFIG_VOLUME=wgdashboard-commercial_amnezia_config
WIREGUARD_CONFIG_VOLUME=wgdashboard-commercial_wireguard_config
DASHBOARD_DATA_VOLUME=wgdashboard-commercial_dashboard_data
POSTGRES_DATA_VOLUME=wgdashboard-commercial_postgres_data
WG_NODE_LOCAL_DATA_VOLUME=wgdashboard-commercial_wg_node_local_data
WG_NODE_LOCAL_CONFIG_VOLUME=wgdashboard-commercial_wg_node_local_config

# Optional: lets new wg-node agents self-register. Leave empty when nodes are
# created manually from the panel. The subscription encryption key is generated
# automatically in the persistent dashboard volume when left empty.
WGD_NODE_BOOTSTRAP_TOKEN=
WGD_SUBSCRIPTION_ENCRYPTION_KEY=

# The panel automatically registers and runs its own local wg-node. PUBLIC_IP
# below is required so generated customer configurations use a reachable endpoint.
WGD_LOCAL_NODE_NAME=panel-local
WGD_LOCAL_NODE_REGION=Local
WGD_LOCAL_NODE_CAPACITY=0
WG_NODE_POLL_SECONDS=5
WG_NODE_REPORT_SECONDS=10
WG_NODE_PRESHARED_KEY=true
# Off by default — needs a host-wide (not interface-scoped) sysctl. See
# wg-node/README.md's "Gaming allowlist and top-traffic report".
WG_NODE_TOP_TRAFFIC_REPORT=false

# Adminer web database manager. Reachable at http://PUBLIC_IP:DB_ADMIN_PORT
# by default (0.0.0.0). Its login page still requires the real Postgres
# credentials, but it's a DB admin UI facing the internet either way — set
# DB_ADMIN_BIND=127.0.0.1 here to go back to localhost-only (SSH tunnel for
# remote access), or firewall this port off to trusted IPs only.
DB_ADMIN_BIND=0.0.0.0
DB_ADMIN_PORT=8080

TZ=Asia/Tehran
WGD_PORT=10086
WG_PORT=51820
# Only used to bake the legacy wg0.conf.template at image build time
# (docker/compose.build.yaml); the commercial nodes system (including this
# panel's own bundled local node) always picks its own address pool.
WG_NETWORK=10.0.0.1
WG_SUBNET=24
WG_AUTOSTART=wg0
GLOBAL_DNS=1.1.1.1

# Required for the built-in local node and customer configuration endpoint.
PUBLIC_IP=replace-with-server-public-ip-or-hostname

# Optional: fronts the panel with nginx over HTTPS, with a free Let's
# Encrypt certificate issued and renewed automatically. Point this domain's
# DNS A record at PUBLIC_IP first, then set all three values here (yes,
# COMPOSE_PROFILES=https too - without it these containers don't start at
# all, so an existing web server on ports 80/443 is never disturbed). Leave
# WGD_DOMAIN empty to skip this — the panel stays reachable at
# http://PUBLIC_IP:10086 either way.
WGD_DOMAIN=
WGD_DOMAIN_EMAIL=
COMPOSE_PROFILES=
