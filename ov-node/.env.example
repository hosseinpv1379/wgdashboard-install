OV_NODE_IMAGE=ghcr.io/hosseinpv1379/ov-node:latest
OV_PANEL_URL=https://panel.example.com
OV_NODE_ID=replace-with-node-id
OV_NODE_TOKEN=replace-with-node-token
# Alternative to the two values above: set the same bootstrap token configured
# on the central panel. Credentials will be saved in the persistent
# ov_node_data volume after first registration.
OV_NODE_BOOTSTRAP_TOKEN=
OV_NODE_NAME=germany-ovpn-1
OV_NODE_REGION=Germany
OV_NODE_PUBLIC_ENDPOINT=vpn.example.com:1194
# That's the whole connection identity. The agent does not create any
# OpenVPN interface on its own — register the node once, then create its
# first (and every later) interface from Commercial Panel → OpenVPN → Add
# interface. No need to install OpenVPN, generate any certificate, or write
# a config by hand — the agent runs its own certificate authority and
# provisions everything itself.
OV_NODE_CAPACITY=500
OV_NODE_POLL_SECONDS=5
OV_NODE_REPORT_SECONDS=10
# Every interface always runs a UDP and a TCP OpenVPN instance side by side
# (own port and half the address pool each), so a single issued client
# certificate connects over either — the downloaded .ovpn file contains both
# as separate <connection> blocks and the client falls back automatically.
OV_NODE_LISTEN_PORT_UDP=1194
OV_NODE_LISTEN_PORT_TCP=1195
# Put optional TLS files in ov-node/certs/ (mounted read-only by Compose).
# This is the agent-to-panel connection's TLS, unrelated to the OpenVPN
# server's own certificate authority described above.
# OV_NODE_CA_CERT=/etc/ov-node/certs/panel-ca.crt
# OV_NODE_CLIENT_CERT=/etc/ov-node/certs/ov-node.crt
# OV_NODE_CLIENT_KEY=/etc/ov-node/certs/ov-node.key
# OV_NODE_INSECURE_TLS=false
