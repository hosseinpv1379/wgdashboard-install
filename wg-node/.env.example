WG_NODE_IMAGE=ghcr.io/hosseinpv1379/wg-node:latest
WG_PANEL_URL=https://panel.example.com
WG_NODE_ID=replace-with-node-id
WG_NODE_TOKEN=replace-with-node-token
# Alternative to the two values above: set the same bootstrap token configured
# as WGD_NODE_BOOTSTRAP_TOKEN on the central panel. Credentials will be saved in
# the persistent wg_node_data volume after first registration.
WG_NODE_BOOTSTRAP_TOKEN=
WG_NODE_NAME=germany-1
WG_NODE_REGION=Germany
WG_NODE_PUBLIC_ENDPOINT=vpn.example.com:51820
WG_NODE_INTERFACE=wg0
# The agent creates this interface itself on first run if it does not already
# exist: it generates the server's private key, enables IP forwarding and
# NAT, and brings the interface up. WG_NODE_POOL_PREFIX only sets the SIZE of
# the client address pool (22, 23, 24, ...); the agent picks a free 10.x.0.0
# block for it automatically. Leave WG_NODE_ADDRESS_POOL empty for this;
# only set it to an exact CIDR (like 10.88.0.0/24) if you need a specific
# network instead of an auto-picked one.
WG_NODE_ADDRESS_POOL=
WG_NODE_POOL_PREFIX=24
WG_NODE_LISTEN_PORT=51820
WG_NODE_CAPACITY=500
WG_NODE_POLL_SECONDS=5
WG_NODE_REPORT_SECONDS=10
WG_NODE_PRESHARED_KEY=true
WG_NODE_OUTBOUND_DIR=/etc/wg-node/outbounds
# Put optional TLS files in wg-node/certs/ (mounted read-only by Compose).
# WG_NODE_CA_CERT=/etc/wg-node/certs/panel-ca.crt
# WG_NODE_CLIENT_CERT=/etc/wg-node/certs/wg-node.crt
# WG_NODE_CLIENT_KEY=/etc/wg-node/certs/wg-node.key
# WG_NODE_INSECURE_TLS=false
